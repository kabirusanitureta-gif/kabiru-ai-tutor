# Kabiru AI Tutor - Environment Config
APP_NAME="Kabiru AI Tutor"

# Set to "production" on Render/Railway/Vercel. Enables loud startup warnings
# if SECRET_KEY or DATABASE_URL are still using insecure/non-persistent defaults.
ENV=development

# REQUIRED in production. Generate a unique value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the default dev key in production — it is public in this repo.
SECRET_KEY=change_this_to_a_long_random_secret_key_before_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local/offline development (Termux, Pydroid, Linux, Windows): SQLite works
# with zero setup.
DATABASE_URL=sqlite:///./kabiru_tutor.db
#
# PRODUCTION (Render/Railway): Render and Railway's web service filesystems
# are EPHEMERAL — the SQLite file is wiped on every redeploy and periodic
# restart, which deletes all registered users (this is what caused the
# "Incorrect email or password after redeploy" and JWT validation bugs).
# Use a persistent Postgres database instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# On Render: create a free Postgres instance and copy its "Internal Database
# URL" here. On Railway: add a Postgres plugin and use its provided
# DATABASE_URL reference variable.

# --- Local AI (Ollama, optional, free, fully offline) ---
# The backend automatically detects Ollama and picks the best installed
# model. If Ollama isn't installed or unreachable, the built-in rule-based
# tutor is used instead — the app always works, no paid API required.
OLLAMA_BASE_URL=http://localhost:11434
# Leave as "auto" to let the backend pick the best installed model using the
# priority order below. Set an exact model name (e.g. "llama3.1:8b") to force
# a specific model instead.
OLLAMA_MODEL=auto
# Priority order for auto-selection, comma-separated (first match wins).
OLLAMA_PREFERRED_MODELS=qwen,deepseek,llama,gemma,mistral
OLLAMA_ENABLED=true

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slashes).
# Local dev origins (localhost:5173) are always allowed automatically.
FRONTEND_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app
